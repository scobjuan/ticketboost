{#
 # TicketBoost plugin for GLPI. Administration page.
 #}
<div class="container-fluid my-3">
   <form method="post" action="{{ action }}" data-tb-config data-tb-messages="{{ messages|json_encode }}">

      {% if issues|length > 0 %}
         <div class="alert alert-danger" role="alert" data-tb-issues>
            <strong>{{ __('The settings were not saved', 'ticketboost') }}</strong>
            <ul class="mb-0">
               {% for issue in issues %}<li>{{ issue }}</li>{% endfor %}
            </ul>
         </div>
      {% endif %}

      <div class="card mb-3">
         <div class="card-header"><h3 class="card-title">{{ __('Leader key', 'ticketboost') }}</h3></div>
         <div class="card-body row g-3">
            <div class="col-md-3">
               <label class="form-label" for="tb-leader-key">{{ __('Key', 'ticketboost') }}</label>
               <select class="form-select" id="tb-leader-key" name="leader[key]">
                  {% for key in leader_keys %}
                     <option value="{{ key }}"{{ key == leader.key ? ' selected' }}>{{ key }}</option>
                  {% endfor %}
               </select>
            </div>
            <div class="col-md-3">
               <label class="form-label" for="tb-leader-mode">{{ __('Activation', 'ticketboost') }}</label>
               <select class="form-select" id="tb-leader-mode" name="leader[mode]">
                  {% for mode, label in leader_modes %}
                     <option value="{{ mode }}"{{ mode == leader.mode ? ' selected' }}>{{ label }}</option>
                  {% endfor %}
               </select>
            </div>
            <div class="col-md-3">
               <label class="form-label" for="tb-leader-taps">{{ __('Number of taps', 'ticketboost') }}</label>
               <input class="form-control" id="tb-leader-taps" type="number" min="1" max="3" name="leader[taps]" value="{{ leader.taps }}">
            </div>
            <div class="col-md-3">
               <label class="form-label" for="tb-leader-tapmax">{{ __('Longest tap (ms)', 'ticketboost') }}</label>
               <input class="form-control" id="tb-leader-tapmax" type="number" min="100" max="1000" name="leader[tapMaxMs]" value="{{ leader.tapMaxMs }}">
            </div>
            <div class="col-md-3">
               <label class="form-label" for="tb-leader-window">{{ __('Time between taps (ms)', 'ticketboost') }}</label>
               <input class="form-control" id="tb-leader-window" type="number" min="100" max="1000" name="leader[tapWindowMs]" value="{{ leader.tapWindowMs }}">
            </div>
            <div class="col-md-3">
               <label class="form-label" for="tb-leader-hold">{{ __('Hold time (ms)', 'ticketboost') }}</label>
               <input class="form-control" id="tb-leader-hold" type="number" min="200" max="2000" name="leader[holdMs]" value="{{ leader.holdMs }}">
            </div>
         </div>
      </div>

      <div class="card mb-3">
         <div class="card-header"><h3 class="card-title">{{ __('Close action', 'ticketboost') }}</h3></div>
         <div class="card-body">
            {% for mode, info in close_modes %}
               <label class="form-check">
                  <input class="form-check-input" type="radio" name="close_mode" value="{{ mode }}"{{ mode == close_mode ? ' checked' }}>
                  <span class="form-check-label"><strong>{{ info.label }}</strong><br><span class="text-muted">{{ info.help }}</span></span>
               </label>
            {% endfor %}
         </div>
      </div>

      <div class="card mb-3">
         <div class="card-header"><h3 class="card-title">{{ __('Shortcuts', 'ticketboost') }}</h3></div>
         <div class="card-body">
            <p class="text-muted">{{ __('Leave a field empty to keep the default. Separate several shortcuts with commas.', 'ticketboost') }}</p>
            {% include '@ticketboost/shortcuts.html.twig' %}
         </div>
      </div>

      <button class="btn btn-primary" type="submit" name="update" value="1">{{ _x('button', 'Save') }}</button>
   {# GLPI closes the form and adds the CSRF token on the versions that use one. #}
   {{ form_end|raw }}
</div>

<script type="module" src="{{ path('/plugins/ticketboost/js/ticketboost-config.js') }}"></script>

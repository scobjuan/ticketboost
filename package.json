{
  "name": "ticketboost",
  "private": true,
  "type": "module",
  "description": "Keyboard shortcuts for faster ticket handling in GLPI",
  "license": "GPL-3.0-or-later",
  "author": "Juan A. Escobar <scobjuan@gmail.com>",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.settings.config.ts",
    "dev": "vite build --watch",
    "lint": "eslint . && stylelint \"frontend/src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "size": "node scripts/size-check.mjs",
    "e2e": "playwright test",
    "agents:check": "node scripts/agents-check.mjs",
    "agents:link": "node scripts/agents-link.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": "eslint --fix",
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{ts,js,mjs,json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.7",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-jsdoc": "^65.5.4",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
